{
  "name": "random-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-mechanics.ts",
    "preview": "vite preview --host 0.0.0.0",
    "balance": "tsx scripts/generate-tier-matrix.ts",
    "balance:check": "npm run balance && tsx scripts/check-balance.ts",
    "balance:optimize": "tsx scripts/optimize-balance.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^6.1.0"
  }
}
