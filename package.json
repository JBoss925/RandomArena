{
  "name": "random-arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/test-mechanics.ts",
    "preview": "vite preview",
    "balance": "tsx scripts/generate-tier-matrix.ts --all",
    "balance:matchup": "tsx scripts/generate-tier-matrix.ts --matchup",
    "balance:fighter": "tsx scripts/generate-tier-matrix.ts --fighter",
    "balance:fighters": "tsx scripts/generate-tier-matrix.ts --fighters",
    "balance:assemble": "tsx scripts/generate-tier-matrix.ts --assemble",
    "balance:check": "tsx scripts/check-balance.ts",
    "balance:optimize": "tsx scripts/optimize-balance.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
